# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Prince"
APP_NAME="Prince"

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prince?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v4)
# NextAuth v4 reads NEXTAUTH_SECRET and NEXTAUTH_URL (NOT AUTH_SECRET).
# NEXTAUTH_SECRET is REQUIRED in production. Generate with: openssl rand -base64 32
# NEXTAUTH_URL must be the full public origin, e.g. https://your-app.up.railway.app
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true" # REQUIRED in production when behind a proxy (Railway, Vercel, etc.). Must be "true" for host header to be trusted.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Background Job Authentication (REQUIRED in production)
# Set this to a strong secret and include it as x-api-key header
# when calling background job endpoints via cron.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
BACKGROUND_JOB_API_KEY=""

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs per plan
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""

# ---------------------------------------------------------------------------
# PayPal (for invoice payment links)
# ---------------------------------------------------------------------------
PAYPAL_BUSINESS_EMAIL=""

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="yourdomain.com"
# NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"

# ---------------------------------------------------------------------------
# Testing / Development
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_UNLOCK_ALL_FEATURES="true" to bypass feature gating for testing

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible storage for photo attachments)
# R2_PUBLIC_URL must be the PUBLIC bucket URL used to READ objects
# (e.g. https://<hash>.r2.dev or a custom domain), NOT the S3 API endpoint.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL="https://<hash>.r2.dev"
