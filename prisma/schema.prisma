// Prisma schema for Prince Invoice Generator
// Database: PostgreSQL

generator client {
  // Railway runs on node:*-alpine (musl). On Alpine 3.18+ the only system
  // OpenSSL is 3.x (libssl.so.3). The plain "linux-musl" engine is built
  // against OpenSSL 1.1 (libssl.so.1.1), which is absent on modern Alpine, so
  // it is excluded. "linux-musl-openssl-3.0.x" + "native" makes the builder
  // stitch the OpenSSL-3 musl engine; the runner must provide libssl.so.3
  // (apk add openssl). See PrismaClientInitializationError in production logs.
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InvoiceType {
  STANDARD
  PROGRESS
  RECURRING
  EXPENSE
}

enum PaymentMethod {
  CASH
  CHECK
  CREDIT_CARD
  CARD
  STRIPE
  PAYPAL
  BANK_TRANSFER
  WIRE
  ACH
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  UNPAID
  OVERDUE
  VOID
  CANCELLED
  WRITTEN_OFF
}

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  CONVERTED
  INVOICED
}

enum ChangeOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  VOID
  PROPOSED
  INVOICED
}

enum ChangeType {
  ADD
  REMOVE
  MODIFY
  REPLACE
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ExpenseCategory {
  LABOR
  MATERIALS
  EQUIPMENT
  SUBCONTRACTOR
  PERMITS
  TRAVEL
  OTHER
}

enum EntityType {
  INVOICE
  ESTIMATE
  CHANGE_ORDER
  EXPENSE
  PROJECT
  PAYMENT
}

enum AddressType {
  BILLING
  SHIPPING
}

enum TemplateStyle {
  STANDARD
  MODERN
  MINIMAL
  CLASSIC
  PROFESSIONAL
}

// ---------------------------------------------------------------------------
// Auth (Auth.js Prisma Adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  locale        String?   @default("en")
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  role           OrgRole       @default(OWNER)

  accounts        Account[]
  sessions        Session[]
  timeEntries     TimeEntry[]
  onboardingState OnboardingState?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  type       String   @default("EMAIL_VERIFY")

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Organization / Team (Business tier: multiple users)
// ---------------------------------------------------------------------------

model Organization {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String              @unique
  plan                 SubscriptionPlan    @default(FREE)
  ownerId              String              @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  subscriptionStatus   SubscriptionStatus?
  currentPeriodEnd     DateTime?
  defaultLocale        String?             @default("en")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  theme       String        @default("light")
  brandColor  String?
  accentColor String?
  fontFamily  String?
  layout      String        @default("default")
  template    TemplateStyle @default(STANDARD)

  localizedStrings LocalizedString[]

  // Identity
  logoUrl            String?
  industry           String?
  businessType       String?
  registrationNumber String?
  website            String?

  // Contact
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("US")
  phone        String?
  email        String?

  // Compliance
  taxId     String?
  taxIdType String?

  // Localization
  currency     String @default("USD")
  language     String @default("en")
  timezone     String @default("America/New_York")
  dateFormat   String @default("MM/DD/YYYY")
  numberFormat String @default("en-US")

  // Billing Defaults
  defaultTaxRate      Float  @default(0)
  defaultPaymentTerms String @default("NET_30")

  users                User[]
  customers            Customer[]
  addresses            CustomerAddress[]
  projects             Project[]
  invoices             Invoice[]
  estimates            Estimate[]
  catalogItems         CatalogItem[]
  estimateAuditLogs    EstimateAudit[]
  changeOrders         ChangeOrder[]
  changeOrderAuditLogs ChangeOrderAudit[]
  documentAuditLogs    DocumentAuditLog[]
  expenses             Expense[]
  subcontractors       Subcontractor[]
  photoAttachments     PhotoAttachment[]
   timeEntries          TimeEntry[]
   invoicePdfs          InvoicePdf[]
   recurringConfigs     RecurringInvoiceConfig[]
   payments             Payment[]
   auditLogs            InvoiceAudit[]
   reminderConfigs      ReminderConfig[]
   reminders            Reminder[]
   reminderSuppressions InvoiceReminderSuppression[]
   lateFeeConfig        LateFeeConfig?
   settings             OrganizationSettings?
   paymentInfo          PaymentInfo?
   milestones           ProjectMilestone[]
}

// ---------------------------------------------------------------------------
// Onboarding State
// ---------------------------------------------------------------------------

model OnboardingState {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentStep    String   @default("identity")
  completedSteps String[] // ["identity", "contact", ...]

  identityData   Json?
  contactData    Json?
  complianceData Json?

  isComplete  Boolean   @default(false)
  completedAt DateTime?

  startedAt    DateTime @default(now())
  lastActiveAt DateTime @updatedAt

  @@index([userId])
  @@index([isComplete])
}

// ---------------------------------------------------------------------------
// Organization Settings
// ---------------------------------------------------------------------------

model OrganizationSettings {
  id                   String       @id @default(cuid())
  orgId                String       @unique
  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  emailSubjectTemplate String?
  emailBodyTemplate    String?
  autoReminders        Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

// ---------------------------------------------------------------------------
// Payment Info
// ---------------------------------------------------------------------------

model PaymentInfo {
  id                  String       @id @default(cuid())
  orgId               String       @unique
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  showOnInvoice       Boolean      @default(true)
  paymentInstructions String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  company   String?
  email     String?
  phone     String?
  website   String?
  taxId     String?
  address   String? // Legacy field - use addresses relation for structured address
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Portal Access
  portalAccess Boolean @default(false)
  portalPin    String?

  // Financial Summary (denormalized for performance, recalculated on invoice/payment events)
  outstandingBalance Float @default(0)
  totalInvoiced      Float @default(0)
  totalPaid          Float @default(0)

  // Status
  status     CustomerStatus @default(ACTIVE)
  archivedAt DateTime?

   // Relations
   invoices         Invoice[]
   estimates        Estimate[]
   changeOrders     ChangeOrder[]
   projects         Project[]
  recurringConfigs RecurringInvoiceConfig[]
  addresses        CustomerAddress[]
  portalSessions   PortalSession[]

  @@unique([orgId, email])
  @@index([orgId])
  @@index([orgId, status])
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
}

// ---------------------------------------------------------------------------
// Customer Portal Sessions (client-facing authentication)
// ---------------------------------------------------------------------------

model PortalSession {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token          String    @unique
  expiresAt      DateTime
  lastAccessedAt DateTime  @default(now())
  ipAddress      String?
  userAgent      String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([customerId])
  @@index([token])
}

// ---------------------------------------------------------------------------
// Customer saved addresses (Free tier)
// ---------------------------------------------------------------------------

model CustomerAddress {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  type       AddressType  @default(BILLING)
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String?
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([orgId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Projects (Business tier: project management)
// ---------------------------------------------------------------------------

model Project {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
   name       String
   number     String?  // project number / job number
   address    String?
  startDate  DateTime?
  endDate    DateTime?
   // Construction-specific fields
  estCompletionDate DateTime? // estimated completion date
  contractValue       Float     @default(0) // original contract value
  paymentTerms       String     @default("NET_30") // e.g. "NET_30", "COD"
  taxRate             Float      @default(0) // default tax rate for project invoices
  retainageRate       Float      @default(0) // retainage percentage withheld
  depositRequired     Float      @default(0) // deposit amount or percentage
  depositPaid         Float      @default(0) // deposit already paid
  projectManager      String?    // name/email of project manager
  status     String       @default("ACTIVE") // ACTIVE, COMPLETED, ON_HOLD, CANCELLED
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

   invoices                 Invoice[]
   estimates                Estimate[]
   changeOrders             ChangeOrder[]
   expenses                 Expense[]
   subcontractorAssignments SubcontractorProject[]
   recurringConfigs         RecurringInvoiceConfig[]
   timeEntries              TimeEntry[]
   milestones               ProjectMilestone[]

   @@index([orgId])
}

// ---------------------------------------------------------------------------
// Project Milestones (Progress billing / Unbilled Revenue)
// ---------------------------------------------------------------------------

enum MilestoneStatus {
   PENDING
   COMPLETED
   INVOICED
   CANCELLED
}

model ProjectMilestone {
   id          String           @id @default(cuid())
   orgId       String
   org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
   projectId   String
   project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
   name        String
   description String?
   amount      Float            @default(0) // billable value of this milestone
   dueDate     DateTime?
   status      MilestoneStatus  @default(PENDING)
   completedAt DateTime?          // when the milestone was marked complete
   invoiceId   String?            // invoice generated for this milestone (optional)
   invoice     Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
   createdAt   DateTime          @default(now())
   updatedAt   DateTime          @updatedAt

   @@index([orgId])
   @@index([orgId, projectId])
   @@index([orgId, status])
}

// ---------------------------------------------------------------------------
// Invoices (core feature across all tiers)
// ---------------------------------------------------------------------------

model Invoice {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number     String
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  type      InvoiceType   @default(STANDARD)
  status    InvoiceStatus @default(DRAFT)
  issueDate DateTime      @default(now())
  dueDate   DateTime?
  currency  String        @default("USD")

  subtotal  Float @default(0)
  taxRate   Float @default(0)
  taxAmount Float @default(0)
  discount  Float @default(0)
  discountTotal Float @default(0)
  taxTotal      Float @default(0)
  feeTotal      Float @default(0)

  // Retainage (Pro tier): percentage of contract withheld until completion
  retainageRate   Float @default(0)
  retainageAmount Float @default(0)

  total             Float                   @default(0)
  amountPaid        Float                   @default(0)
  amountCredited    Float                   @default(0) // credits applied (credit memos, etc.)
  amountDue         Float                   @default(0)  // total - payments - credits
  lateFeeAmount     Float                   @default(0)
  scheduledFor      DateTime?
  notes             String?
  customerNotes     String?
  internalNotes     String?
  termsAndConditions String?
  paymentTerms      String                  @default("NET_30")
  stripeInvoiceId   String?
  recurringConfigId String?
  recurringConfig   RecurringInvoiceConfig? @relation("RecurringInvoices", fields: [recurringConfigId], references: [id])
  logoUrl           String?
  billToAddress     String?
  shipToAddress     String?

  // Links to source documents. An invoice may reference an estimate OR a change
  // order, but neither is required (invoices can be created directly).
  estimateId    String?   @unique
  estimate      Estimate? @relation("EstimateToInvoice", fields: [estimateId], references: [id], onDelete: SetNull)
  changeOrders  ChangeOrder[]  // change orders referenced by this invoice

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items                InvoiceItem[]
  payments             Payment[]
  auditLogs            InvoiceAudit[]
   reminders            Reminder[]
   reminderSuppressions InvoiceReminderSuppression[]
   timeEntries          TimeEntry[]
   invoicePdfs          InvoicePdf[]
   milestones           ProjectMilestone[]

   @@unique([orgId, number])
  @@index([orgId])
  @@index([customerId])
  @@index([estimateId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float   @default(1)
  unit        String  @default("units")
  unitPrice   Float   @default(0)
  discountType DiscountType? @default(PERCENT)
  discountValue Float? @default(0)
  taxable      Boolean @default(false)
  taxRate      Float   @default(0)
  lineSubtotal Float   @default(0)
  lineDiscount Float   @default(0)
  lineTax      Float   @default(0)
  lineTotal    Float   @default(0)
  amount      Float   @default(0) // legacy alias for lineTotal
  sortOrder   Int     @default(0)
  sku         String?
  // Traceability back to the source of the billed item.
  sourceType  String? // "estimate_item" | "change_order_item" | "project_task" | "work_item"
  sourceId    String?

  @@index([invoiceId])
  @@index([sourceType, sourceId])
}

// ---------------------------------------------------------------------------
// Estimates (Starter tier+)
// ---------------------------------------------------------------------------

model Estimate {
  id         String         @id @default(cuid())
  orgId      String
  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number     String
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status     EstimateStatus @default(DRAFT)
  issueDate  DateTime       @default(now())
  // Proposal validity. validUntil is the existing column; expirationDate is
  // the spec-mandated alias used by the new calculation layer.
  validUntil  DateTime?
  expirationDate DateTime?
  currency      String         @default("USD")
  subtotal      Float          @default(0)
  taxRate       Float          @default(0)
  taxAmount     Float          @default(0)
  discount      Float          @default(0)
  discountTotal Float          @default(0)
  taxTotal      Float          @default(0)
  feeTotal      Float          @default(0)
  total         Float          @default(0)

  // Engagement tracking (v2 enhancement)
  shareToken      String? // cryptographically random UUID for secure link
  viewedAt        DateTime? // when customer first viewed
  acceptedAt      DateTime? // when customer accepted
  acceptedBy      String?   // user/customer who accepted
  rejectedAt      DateTime? // when customer rejected
  rejectionReason String? // free-text or predefined code
  convertedAt     DateTime? // when converted to invoice
  sentAt          DateTime? // when estimate was sent to customer

  // Electronic signature support
  signatureId      String?
  signedAt         DateTime?
  signedBy         String?
  signatureMethod  String?

  // Prose fields
  customerNotes       String?
  internalNotes       String?
  termsAndConditions  String?
  notes               String?
  title               String?
  billToAddress       String?

  // Conversion to invoice
  linkedInvoiceId String?
  linkedInvoice   Invoice? @relation("EstimateToInvoice")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     EstimateItem[]
  auditLogs EstimateAudit[]
  changeOrders ChangeOrder[]  // change orders originating from this estimate

  @@unique([orgId, number])
  @@index([orgId])
}

model EstimateItem {
  id           String   @id @default(cuid())
  estimateId   String
  estimate     Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  position     Int      @default(0)
  itemId       String?  // links to a CatalogItem when applicable
  description  String
  quantity     Float    @default(1)
  unit         String   @default("units")
  unitPrice    Float    @default(0)
  discountType DiscountType? @default(PERCENT)
  discountValue Float?  @default(0)
  taxable      Boolean  @default(false)
  taxRate      Float    @default(0)
  lineSubtotal Float    @default(0)
  lineDiscount Float    @default(0)
  lineTax      Float    @default(0)
  lineTotal    Float    @default(0)
  isOptional   Boolean  @default(false)
  amount       Float    @default(0) // legacy alias for lineTotal
  sortOrder    Int      @default(0)
  sku          String?

  @@index([estimateId])
}

// ---------------------------------------------------------------------------
// Estimate Audit Trail (engagement tracking, status changes)
// ---------------------------------------------------------------------------

model EstimateAudit {
  id          String       @id @default(cuid())
  estimateId  String
  estimate    Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  action      String // VIEWED, SENT, ACCEPTED, REJECTED, EXPIRED, CONVERTED_TO_INVOICE, COMMENT_ADDED
  fromStatus  String?
  toStatus    String?
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([estimateId])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Change Orders (Pro tier)
// ---------------------------------------------------------------------------

model ChangeOrder {
  id          String            @id @default(cuid())
  orgId       String
  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number      String
  customerId  String?
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  estimateId  String?           // the estimate this change order modifies
  estimate    Estimate?         @relation(fields: [estimateId], references: [id], onDelete: SetNull)
   contractId  String?           // optional external contract reference
   invoiceId   String?           // invoice generated from an approved change order (optional)
   invoice     Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

   status      ChangeOrderStatus @default(DRAFT)
   issueDate   DateTime          @default(now())
   effectiveDate DateTime?       // when scope changes take effect
   reason      String?
   description String?

   // Scope & schedule change description
   scopeChangeDescription   String?
   scheduleImpactDescription String?

   // Financial: originals preserved, deltas computed
   originalTotal   Float  @default(0)   // contract value before this change
   amount          Float  @default(0)   // legacy: total amount of this change order
   changeAmount    Float  @default(0)   // net delta (this change order only)
   revisedTotal    Float  @default(0)   // originalTotal + approved changeAmount

  currency        String         @default("USD")

  // Prose fields
   customerNotes       String?
   internalNotes       String?
   termsAndConditions  String?
   title               String
   notes               String?

   // Approval workflow
   approvedAt  DateTime?
   approvedBy  String?
   rejectedAt  DateTime?
   rejectedBy  String?

   // Schedule impact
   originalCompletionDate DateTime?
   daysAdded              Int?    // additional calendar days required
   newCompletionDate      DateTime?

   // Location of work (site address for the change)
   billToAddress          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     ChangeOrderLineItem[]
  auditLogs ChangeOrderAudit[]

  @@unique([orgId, number])
  @@index([orgId])
  @@index([estimateId])
  @@index([projectId])
  @@index([customerId])
}

model ChangeOrderLineItem {
  id                   String      @id @default(cuid())
  changeOrderId        String
  changeOrder          ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  position             Int         @default(0)
  changeType           ChangeType
  originalLineItemId   String?     // links to the EstimateItem/InvoiceItem being modified
  itemId               String?     // links to a CatalogItem when applicable
  description          String
  quantityBefore       Float?
  quantityAfter        Float?
  quantityDelta        Float?      // quantityAfter - quantityBefore (computed)
  unit                 String?     @default("units")
  unitPriceBefore      Float?
  unitPriceAfter       Float?
  unitPriceDelta       Float?      // unitPriceAfter - unitPriceBefore (computed)
  lineAmount           Float       @default(0)   // line-level dollar delta
  taxable                Boolean     @default(false)
  taxRate                Float       @default(0)
  lineTax                Float       @default(0)

  @@index([changeOrderId])
}

// ---------------------------------------------------------------------------
// Change Order Audit Trail (approval workflow, status changes)
// ---------------------------------------------------------------------------

model ChangeOrderAudit {
  id             String          @id @default(cuid())
  changeOrderId  String
  changeOrder    ChangeOrder     @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  orgId          String
  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  action         String          // CREATED, SUBMITTED, APPROVED, REJECTED, CANCELLED, VOIDED
  fromStatus     ChangeOrderStatus?
  toStatus       ChangeOrderStatus?
  changedBy      String?
  changedAt      DateTime        @default(now())
  metadata       Json?

  @@index([changeOrderId])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Unified Document Audit Log
// ---------------------------------------------------------------------------
// Append-only trail shared by estimates, change orders, and invoices. Each
// entry references exactly one document via document_type + document_id so the
// three document types keep separate business semantics while sharing the same
// audit infrastructure. Events: ESTIMATE_CREATED, ESTIMATE_SENT,
// ESTIMATE_ACCEPTED, CHANGE_ORDER_CREATED, CHANGE_ORDER_SUBMITTED,
// CHANGE_ORDER_APPROVED, CHANGE_ORDER_REJECTED, INVOICE_CREATED,
// INVOICE_SENT, PAYMENT_RECORDED, INVOICE_PAID, INVOICE_VOIDED.

model DocumentAuditLog {
  id             String        @id @default(cuid())
  orgId          String
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documentType   String    // "estimate" | "change_order" | "invoice"
  documentId     String
  action         String
  previousStatus String?
  newStatus      String?
  changedBy      String?
  changedAt      DateTime  @default(now())
  metadata       Json?

  @@index([orgId])
  @@index([documentType, documentId])
  @@index([documentType, action])
  @@index([changedAt])
}

// ---------------------------------------------------------------------------
// Catalog Items (Starter tier+) — saved product/service library
// ---------------------------------------------------------------------------

enum CatalogUnit {
  HOURS
  UNITS
  FLAT_FEE
  DAYS
  PROJECTS
}

model CatalogItem {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  unit        CatalogUnit  @default(UNITS)
  taxRate     Float        @default(0)
  taxCategory String?
  sku         String?
  discount    Float        @default(0)
  sortOrder   Int          @default(0)
  isFavorite  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orgId, sku])
  @@index([orgId])
  @@index([orgId, name])
}

// ---------------------------------------------------------------------------
// Expenses with photo attachments (Pro tier: expense tracking)
// ---------------------------------------------------------------------------

model Expense {
  id        String           @id @default(cuid())
  orgId     String
  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  vendor    String?
  category  ExpenseCategory  @default(OTHER)
  amount    Float            @default(0)
  date      DateTime         @default(now())
  notes     String?
  photoId   String?          @unique
  photo     PhotoAttachment? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Subcontractor tracking (Business tier)
// ---------------------------------------------------------------------------

model Subcontractor {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  company   String?
  trade     String?
  email     String?
  phone     String?
  rate      Decimal?
  status    String       @default("ACTIVE")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  projects SubcontractorProject[]

  @@index([orgId])
}

model SubcontractorProject {
  id              String        @id @default(cuid())
  subcontractorId String
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedAt      DateTime      @default(now())

  @@unique([subcontractorId, projectId])
}

// ---------------------------------------------------------------------------
// Time Tracking (Starter tier+)
// ---------------------------------------------------------------------------

enum TimeEntryStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  INVOICED
  REJECTED
}

model TimeEntry {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceId String?
  invoice   Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  startTime   DateTime
  endTime     DateTime?
  duration    Float           @default(0) // Duration in seconds
  description String?
  billable    Boolean         @default(true)
  hourlyRate  Float           @default(0)
  amount      Float           @default(0) // (duration/3600) * hourlyRate
  isManual    Boolean         @default(false)
  status      TimeEntryStatus @default(APPROVED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([orgId])
  @@index([orgId, userId])
  @@index([orgId, projectId])
  @@index([orgId, invoiceId])
  @@index([orgId, billable])
  @@index([orgId, status])
  @@index([orgId, startTime])
}

// ---------------------------------------------------------------------------
// Photo attachments stored on Cloudflare R2 (Pro tier)
// ---------------------------------------------------------------------------

model PhotoAttachment {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key          String // R2 object key
  url          String
  filename     String
  contentType  String?
  size         Int?
  entityType   EntityType?
  entityId     String?
  uploadedById String?
  createdAt    DateTime     @default(now())

  expense Expense?

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Payments (track partial/full payments against invoices)
// ---------------------------------------------------------------------------

model Payment {
  id                  String        @id @default(cuid())
  invoiceId           String
  invoice             Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orgId               String
  org                 Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId          String?       // for tracing which customer paid
  paymentDate         DateTime?     // when the payment was actually received
  amount              Float
  currency            String        @default("USD")
  method              PaymentMethod @default(OTHER)
  reference           String?       // check #, transaction ref, etc.
  status              PaymentStatus @default(COMPLETED)
  stripePaymentId     String?
  paypalTransactionId String?
  note                String?
  createdById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([invoiceId])
  @@index([orgId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Invoice Audit Trail (status changes and significant events)
// ---------------------------------------------------------------------------

model InvoiceAudit {
  id          String       @id @default(cuid())
  invoiceId   String
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  action      String // STATUS_CHANGE, PAYMENT_RECORDED, PAYMENT_LINK_SENT, etc.
  fromStatus  String?
  toStatus    String?
  amount      Float?
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([invoiceId])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Invoice PDFs (generated PDF documents)
// ---------------------------------------------------------------------------

model InvoicePdf {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  url       String // R2 download URL
  paperSize String   @default("A4")
  fileSize  Int? // bytes
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Reminders (automated payment reminders)
// ---------------------------------------------------------------------------

enum ReminderStageType {
  PRE_DUE // daysOffset < 0 — fires before the due date
  DUE_DATE // daysOffset == 0 — fires on the due date
  POST_DUE // daysOffset > 0 — fires after the due date (escalation ladder)
}

model ReminderConfig {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  enabled         Boolean      @default(true)
  remindBeforeDue Int          @default(3) // legacy: days before due date
  remindAfterDue  Int          @default(1) // legacy: days after due date
  frequencyHours  Int          @default(24) // minimum hours between reminders
  maxReminders    Int          @default(3) // max reminders per invoice
  emailSubject    String?      @default("Payment reminder for invoice {{invoiceNumber}}")
  emailTemplate   String?      @default("Dear {{customerName}}, this is a reminder that invoice {{invoiceNumber}} for {{amount}} is due on {{dueDate}}.")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  stages ReminderStage[]

  @@unique([orgId])
  @@index([orgId])
}

model ReminderStage {
  id       String         @id @default(cuid())
  configId String
  config   ReminderConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  name            String // e.g. "Friendly reminder", "1 day overdue"
  type            ReminderStageType
  enabled         Boolean           @default(true)
  daysOffset      Int // negative = before due, 0 = on, positive = after due
  timeOfDay       String? // optional "HH:mm" in org timezone
  subjectTemplate String? // rendered with template variables
  bodyTemplate    String? // rendered with template variables
  channel         String            @default("EMAIL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders Reminder[]

  @@index([configId])
  @@index([type])
}

model Reminder {
  id           String         @id @default(cuid())
  orgId        String
  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoiceId    String?
  invoice      Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  stageId      String?
  stage        ReminderStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  type         String // PRE_DUE | DUE_DATE | POST_DUE_1 | POST_DUE_7 | POST_DUE_14 | POST_DUE_30
  scheduledAt  DateTime
  sentAt       DateTime?
  deliveredAt  DateTime?
  status       String         @default("PENDING") // PENDING, SENT, QUEUED, DELIVERED, FAILED, BOUNCED, SKIPPED
  channel      String         @default("EMAIL") // EMAIL, SMS (future)
  recipient    String? // email address the reminder was sent to
  subject      String? // rendered subject at time of send (for audit)
  note         String?
  errorMessage String?
  metadata     Json? // delivery provider response, message ID, etc.
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([orgId])
  @@index([invoiceId])
  @@index([invoiceId, type])
  @@index([stageId])
}

model InvoiceReminderSuppression {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  suppressedAll Boolean   @default(false) // skip all automated reminders for this invoice
  snoozedUntil  DateTime? // skip reminders until this date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, invoiceId])
  @@index([orgId])
  @@index([invoiceId])
}

model RecurringInvoiceConfig {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  frequency       String       @default("MONTHLY") // MONTHLY, QUARTERLY, etc.
  startDate       DateTime? // don't generate before this date
  endDate         DateTime? // stop generating after this date
  occurrences     Int? // stop after N generated invoices
  generatedCount  Int          @default(0) // invoices generated so far
  paymentTerms    String       @default("NET_30") // NET_7|NET_15|NET_30|NET_60|DUE_ON_RECEIPT
  nextRunDate     DateTime
  autoSend        Boolean      @default(true)
  autoCharge      Boolean      @default(false)
  defaultTaxRate  Float? // overrides the template's taxRate when set
  defaultDiscount Float? // overrides the template's discount when set
  defaultItems    Json? // [{ description, quantity, unitPrice, amount }]
  active          Boolean      @default(true)
  lastInvoiceId   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  invoices Invoice[] @relation("RecurringInvoices")

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Late fee configuration (automation tier)
// ---------------------------------------------------------------------------

model LateFeeConfig {
  id        String       @id @default(cuid())
  orgId     String       @unique
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  enabled   Boolean      @default(false)
  rate      Float        @default(0) // percentage of total amount
  graceDays Int          @default(0) // days after due date before fees apply
  fixedFee  Float        @default(0) // fixed fee added on top of percentage
  maxFee    Float? // cap on total late fee
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Localized content (multilingual user-generated strings)
// ---------------------------------------------------------------------------

model LocalizedString {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entityType String // e.g. "Customer", "Project", "Invoice"
  entityId   String
  field      String // e.g. "name", "description", "notes"
  locale     String // "en", "fr", "es", "de"
  value      String       @db.Text
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([orgId, entityType, entityId, field, locale])
  @@index([orgId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// Security / compliance audit trail
// ---------------------------------------------------------------------------
//
// Append-only record of security-relevant events: authentication, admin
// actions, settings changes, data exports and destructive operations.
// Complements InvoiceAudit / EstimateAudit, which cover financial documents.
//
// Deliberately has NO foreign key to Organization. Audit history must outlive
// the records it describes, and a cascade (or SET NULL) would let an
// application-level delete mutate immutable rows. `orgId` is a plain indexed
// column; rows for a deleted organization are retained for their retention
// period. The migration also installs a trigger rejecting UPDATE and DELETE, so
// entries cannot be altered by application code.

model AuditLog {
  id         String @id @default(cuid())
  /// Organization the event belongs to. Null for pre-organization auth events.
  orgId      String?
  /// User id of the actor. Null for anonymous or system-initiated events.
  actorId    String?
  actorEmail String?
  actorRole  String?
  /// AUTH | ADMIN | SETTINGS | DATA | BILLING | SECURITY
  category   String
  /// Specific event, e.g. LOGIN_SUCCESS, ROLE_CHANGED, DATA_EXPORTED.
  action     String
  /// Entity the action targeted, e.g. "User" / "Organization".
  targetType String?
  targetId   String?
  /// SUCCESS | FAILURE
  outcome    String @default("SUCCESS")

  ip        String?
  userAgent String?
  /// Correlation ID from the x-request-id header.
  requestId String?
  /// Additional non-sensitive context. Never store credentials here.
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([actorId, createdAt])
  @@index([category, action])
  @@index([createdAt])
}

/// Idempotency table for the Stripe webhook (Plan A11).
/// `eventId` is unique so a duplicate delivery of the same Stripe event is
/// detected and skipped before any state mutation runs.
model ProcessedStripeEvent {
  id            String   @id @default(cuid())
  eventId       String   @unique
  eventType     String
  orgId         String?
  /// "OK" | "INVALID_REQUEST" | "TRANSIENT_ERROR"
  outcome       String   @default("OK")
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}
