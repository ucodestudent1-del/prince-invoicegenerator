# Railway environment variables — copy into the app service "Variables" page.
# Replace YOUR_DOMAIN (e.g. https://app.princeinvoicing.com) and the empty values.
# Leave GITHUB_ID / GITHUB_SECRET UNSET (Google-only auth, per plan).

NEXT_PUBLIC_APP_URL="https://YOUR_DOMAIN"
NEXT_PUBLIC_APP_NAME="Prince"
APP_NAME="Prince"
NEXTAUTH_URL="https://YOUR_DOMAIN"
NEXTAUTH_SECRET=""            # openssl rand -base64 32
AUTH_TRUST_HOST="true"

DATABASE_URL=""              # paste Railway PostgreSQL plugin connection string

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""     # from Stripe webhook endpoint signing secret
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_YEARLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_YEARLY=""

# Background jobs — REQUIRED in production.
# Generate with: openssl rand -hex 32
# Set as x-api-key header when calling /api/invoices/recurring/generate via cron
BACKGROUND_JOB_API_KEY=""

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""             # public read URL (https://<hash>.r2.dev or custom domain)

# Note: AUTH_TRUST_HOST is a NextAuth v5 variable, not used by v4.
# In v4, proxy trust is controlled by NEXTAUTH_URL (set above).

# Docker build args: NEXT_PUBLIC_* vars are inlined at build time (into the
# client bundle). Since .env is excluded from the Docker build context
# (.dockerignore), pass them as --build-arg during docker build:
#   docker build --build-arg NEXT_PUBLIC_APP_NAME="Prince" \
#                --build-arg NEXT_PUBLIC_APP_URL="https://your-domain.com" \
#                --build-arg NEXT_PUBLIC_UNLOCK_ALL_FEATURES=true .
# Railway injects these at runtime for server-side code (process.env),
# but client-side inlining happens at build time.
